					&lt;td style="text-align: left"&gt;526&lt;/td&gt;
					&lt;td style="text-align: left"&gt;Beautiful Arrangement&lt;/td&gt;
					&lt;td style="text-align: left"&gt;计数符合特殊规则的排列（回溯/DP）&lt;/td&gt;
			&lt;/tr&gt;
			&lt;tr&gt;
					&lt;td style="text-align: left"&gt;667&lt;/td&gt;
					&lt;td style="text-align: left"&gt;Beautiful Arrangement II&lt;/td&gt;
					&lt;td style="text-align: left"&gt;构造一个特殊差异数组（数学构造）&lt;/td&gt;
